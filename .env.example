# Convex deployment URL - replace with your actual deployment URL
# Run 'npx convex dev' to get the development URL
VITE_CONVEX_URL=

# Convex site URL for auth
CONVEX_SITE_URL=http://localhost:5173

# Deployment used by `npx convex dev`
CONVEX_DEPLOYMENT=

# --- Convex backend env vars (set in the Convex dashboard, not here) -------
# Free-tier "Draft with AI" — set at least one:
#   GROQ_API_KEY=       https://console.groq.com/keys
#   GEMINI_API_KEY=     https://aistudio.google.com/apikey
#
# Billing — set both to enable the Billing tab and paid plans. No products/
# prices need to be pre-created in Stripe; Checkout Sessions are created
# with inline pricing. Point a Stripe webhook at
# `${CONVEX_SITE_URL}/stripe/webhook` for: checkout.session.completed,
# customer.subscription.updated, customer.subscription.deleted.
#   STRIPE_SECRET_KEY=
#   STRIPE_WEBHOOK_SECRET=
