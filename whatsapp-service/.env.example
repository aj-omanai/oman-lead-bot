# Random secret shared with Convex's WHATSAPP_SERVICE_SECRET env var.
# Generate one with: openssl rand -hex 32
WHATSAPP_SERVICE_SECRET=

# Where Baileys persists WhatsApp session credentials. MUST be a persistent
# volume in production — losing this directory logs every workspace out.
WHATSAPP_AUTH_DIR=./auth_state

# Your Convex deployment's HTTP Actions URL (the one CONVEX_SITE_URL points
# to, e.g. https://your-project.convex.site), and a secret shared with
# Convex's WHATSAPP_WEBHOOK_SECRET env var. Both optional — inbound-message
# forwarding is skipped if unset, sending still works.
CONVEX_SITE_URL=
CONVEX_WEBHOOK_SECRET=

PORT=8787
LOG_LEVEL=warn
